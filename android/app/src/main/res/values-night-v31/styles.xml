<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows its own system splash: give it the same night-ink
         background so it hands over seamlessly to the animated Flutter one. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_ink</item>
    </style>
</resources>